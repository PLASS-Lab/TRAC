": {"min_length": 1, "max_length": 250}, "placeholder": "Publisher"}, "field_type": "text", "order": null, "is_mandatory": false}, {"name": "Location", "value": "", "settings": {"validations": {"min_length": 1, "max_length": 250}, "placeholder": "Location"}, "field_type": "text", "order": null, "is_mandatory": false}, {"name": "Name of conference", "value": "", "settings": {"validations": {"min_length": 1, "max_length": 250}, "placeholder": "Name of conference"}, "field_type": "text", "order": null, "is_mandatory": false}, {"name": "Start date", "value": "", "settings": {}, "field_type": "date", "order": null, "is_mandatory": false}, {"name": "End date", "value": "", "settings": {}, "field_type": "date", "order": null, "is_mandatory": false}, {"name": "Language", "value": "", "settings": {"validations": {"min_length": 1, "max_length": 250}, "placeholder": "Language"}, "field_type": "text", "order": null, "is_mandatory": false}, {"name": "Refereed", "value": "", "settings": {"validations": {"min_length": 1, "max_length": 250}, "placeholder": "Refereed"}, "field_type": "text", "order": null, "is_mandatory": false}, {"name": "Provenance", "value": "", "settings": {"validations": {"min_length": 1, "max_length": 250}, "placeholder": "Provenance"}, "field_type": "text", "order": null, "is_mandatory": false}, {"name": "Notes", "value": "", "settings": {"validations": {"min_length": 1, "max_length": 10000}, "placeholder": "Notes"}, "field_type": "textarea", "order": null, "is_mandatory": false}], "figshare_url": "https://curate.curtin.edu.au/articles/journal_contribution/Quantitative_error_analysis_of_bilateral_filtering/31679041", "download_disabled": false, "description": "One of the fastest acceleration techniques for bilateral image filtering is the real time $O(1)$ quantization method proposed by Yang 2009, which first computes some Principal Bilateral Filtered Image Components (PBFICs) and then applies linear interpolation to estimate the filtered output images. There is a trade-off between accuracy and efficiency in selecting the number of PBFICs: the more PBFICs are used, the higher the accuracy, and the higher the computational cost. A question arises: how many PBFICs are required to achieve a certain level of accuracy? In this letter, we address this question by investigating the properties of bilateral filtering and deriving the linear interpolation error bounds when only a subset of PBFICs is used. The provided theoretical analysis indicates that the necessary number of PBFICs for user-provided precision depends on the range kernel and, for typical Gaussian range kernels, a small percentage (typically less than 4%) of the PBFICs are enough for good approximations.", "funding": null, "funding_list": [], "version": 1, "status": "public", "size": 0, "created_date": "2026-03-27T10:41:36Z", "modified_date": "2026-03-27T10:41:36Z", "is_public": true, "is_confidential": false, "is_metadata_record": true, "confidential_reason": "", "metadata_reason": "", "license": {"value": 300, "name": "All rights reserved, written permission required", "url": "https://researchtoolkit.library.curtin.edu.au/publishing/curate/meeting-copyright-obligations#accordion_curate-copyright-statement_collapse_all-rights-reserved"}, "tags": ["Journal Article"], "keywords": ["Journal Article"], "categories": [], "references": ["https://doi.org/10.1109/LSP.2014.2353694", "https://portal.issn.org/resource/ISSN/1070-9908"], "has_linked_file": false, "citation": "An, Senjian; Boussaid, F.; Bennamoun, M.; Sohel, F. (2015). Quantitative error analysis of bilateral filtering. Curtin University. Journal contribution. https://hdl.handle.net/20.500.11937/69751", "related_materials": [{"id": 274420120, "identifier": "10.1109/LSP.2014.2353694", "title": "10.1109/LSP.2014.2353694", "relation": "IsPublishedIn", "identifier_type": "DOI", "is_linkout": true, "link": "https://doi.org/10.1109/LSP.2014.2353694"}, {"id": 274420123, "identifier": "1070-9908", "title": "1070-9908